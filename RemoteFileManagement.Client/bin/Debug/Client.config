<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <system.runtime.remoting>
    <application name="RemoteFileManagementClient">
      <channels>
        <channel ref="tcp">
          <clientProviders>
            <formatter ref="binary" />
          </clientProviders>
        </channel>
      </channels>
      <client>
        <wellknown type="RemoteFileManagement.Shared.IRemoteFileManager, RemoteFileManagement.Shared"
                   url="tcp://localhost:9000/RemoteFileManager" />
      </client>
    </application>
  </system.runtime.remoting>
</configuration>
